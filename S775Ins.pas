implementation

procedure InitializeInstruments;
var
  SL: TStringList;
  i, CurrentBank, PNum, Key: Integer;
  Line, Name: string;
begin
  if Assigned(InsCache) then Exit;
  InsCache := TInsCache.Create;
  SL := TStringList.Create;
  try
    SL.Text := RAW_INS_CONTENT;
    CurrentBank := -1;

    for i := 0 to SL.Count - 1 do
    begin
      Line := Trim(SL[i]);
      if Line = '' then Continue;

      // Szukamy nag³ówka [ ... numer]
      if (Line[1] = '[') and (Line[Length(Line)] = ']') then
      begin
        // Wyci¹gamy ostatni¹ liczbê przed "]" - to obs³u¿y liniê 1573 "[... Drums 127]"
        CurrentBank := StrToIntDef(Copy(Line, LastDelimiter(' ', Line) + 1, Length(Line) - LastDelimiter(' ', Line) - 1), -1);
        Continue;
      end;

      // Jeœli jesteœmy w jakimœ banku i mamy liniê "16=Nazwa"
      if (CurrentBank <> -1) and (Pos('=', Line) > 0) and (Line[1] in ['0'..'9']) then
      begin
        PNum := StrToIntDef(Copy(Line, 1, Pos('=', Line)-1), -1);
        if PNum <> -1 then
        begin
          Name := Trim(Copy(Line, Pos('=', Line) + 1, MaxInt));
          // Czyœcimy nawiasy (Organ)
          if Pos('(', Name) > 0 then Name := Trim(Copy(Name, 1, Pos('(', Name)-1));

          Key := (CurrentBank * 128) + PNum;
          InsCache.AddOrSetValue(Key, Name);
        end;
      end;
    end;
  finally
    SL.Free;
  end;
end;

function GetInstrumentName(BankNum, PatchNum: Integer): string;
var
  SL: TStringList;
  i, p: Integer;
  Line, TargetHeader, SearchPatch: string;
  InSection: Boolean;
begin
  Result := '';
  InSection := False;

  // Cel: [Drums] dla 127, reszta zgodnie z numerem banku
  if BankNum = 127 then TargetHeader := '[Drums]'
  else TargetHeader := 'Bank ' + IntToStr(BankNum) + ']';

  SearchPatch := IntToStr(PatchNum) + '=';

  SL := TStringList.Create;
  try
    SL.Text := RAW_INS_CONTENT;
    for i := 0 to SL.Count - 1 do
    begin
      Line := Trim(SL[i]);
      if Line = '' then Continue;

      // Szukamy nag³ówka (GOTO)
      if (Pos('[', Line) > 0) and (Pos(TargetHeader, Line) > 0) then
      begin
        InSection := True;
        Continue;
      end;

      if InSection then
      begin
        // Jeœli nowa sekcja [ ] - koniec szukania w tej sekcji
        if (Pos('[', Line) = 1) and (Pos(TargetHeader, Line) = 0) then Break;

        // Szukamy "16="
        if Pos(SearchPatch, Line) = 1 then
        begin
          p := Pos('=', Line);
          Result := Trim(Copy(Line, p + 1, MaxInt));
          p := Pos('(', Result); if p > 0 then Result := Trim(Copy(Result, 1, p - 1));
          Exit; // MAMY TO
        end;
      end;
    end;
  finally
    SL.Free;
  end;
end;

end.
