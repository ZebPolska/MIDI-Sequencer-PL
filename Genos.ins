; --- P A T CH   B R O W S E R   S P E C I A L  F U N C T I O N ---
; Please use the following shortcuts for searching categories inside the 
; Patch Browser:
;
; Piano = Piano Voices
; EPiano = E.Piano Voices
; Bass = Bass Voices
; Brass = Brass Voices
; Strings = String Voices
; Ensemble = Ensemble Voices
; A.Guitar = Acoustic Guitar Voices
; E.Guitar = Electric Guitar Voices
; Pad = Pad Voices
; Synth = Synthy Voices, Lead Synthesizer Voices
; Choir = Choir Voices, Voice Voices
; Woodwind = Saxophone Voices, Oboe Voices, English Horn Voices, Flute Voices, Clarinet Voices
; Tru&Tro = Trumpet Voices, Trombone Voices, Tuba Voices, Horn Voices
; Organ = Organ Voices
; OrganWrld = Organ World
; Perc = Percusive Voices
; Accordion = Accordion Voices, Harmonica Voices
; Sfx = Single Sfx Effects
; DrumKit = Drumkits
; Drumsound = Single Drum Voices
;
; Mega = Mega Voices
; Artic = Articulation, Super Articulation Voices, Super Articulation 2 Voices
;
; -----------------------------------------------------------------------------

