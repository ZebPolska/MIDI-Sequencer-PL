; *******************************************************************************************
.Controller Names
; *******************************************************************************************

[PSR-SX600 Controllers]
0=Bank Select MSB
1=Modulation
5=Portamento Time
6=Data Entry MSB
7=Master Volume
10=Panpot
11=Expression
16=General Purpose Controller
32=Bank Select LSB
38=Data Entry LSB
64=Sustain
65=Portamento
66=Sostenuto
67=Soft Pedal
71=Harmonic Content
72=Release Time
73=Attack Time
74=Brightness
75=Decay Time
76=Vibrato Rate
77=Vibrato Depth
78=Vibrato Delay
80=General Purpose Controller (Articulation 1)
81=General Purpose Controller (Articulation 2)
82=General Purpose Controller (Articulation 3)
84=Portamento Control
91=Reverb Send Level
93=Chorus Send Level
94=Variation Send Level
96=RPN Increment
97=RPN Decrement
98=NRPN LSB
99=NRPN MSB
100=RPN LSB
101=RPN MSB
120=All Sound Off
121=Reset All Controllers
122=Local Control
123=All Notes Off
124=OMNI Off
125=OMNI On
126=Mono
127=Poly

